# =============================================================================
# VARIABLES DE ENTORNO PARA DOCKER
# =============================================================================
# Copiar este archivo a .env antes de iniciar Docker:
#   cp .env.docker.example .env

# Contraseña del usuario SA de Microsoft SQL Server
MSSQL_SA_PASSWORD=TuSuperClaveSegura2026!

# URL de la base de datos para el contenedor de FastAPI
DATABASE_URL=mssql+pyodbc://sa:TuSuperClaveSegura2026!@sqlserver:1433/PrestamosDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Integración Monolito CoopYa
COOPYA_BASE_URL=https://test.coopya.com.ar
COOPYA_DEFAULT_TOKEN=

# Integración Base Legacy Oracle (Opcional - Modo Thick)
ORACLE_ENABLED=False
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=orcl
ORACLE_DSN=
ORACLE_CLIENT_LIB_DIR=
ORACLE_TABLA_PERSONAS=PRESTAPROD.PERSONA
