# Configuración del Microservicio de Préstamos
PORT=8001

# Integración con Monolito CoopYa
COOPYA_BASE_URL=https://test.coopya.com.ar
COOPYA_DEFAULT_TOKEN=

# Base de datos SQL Server
DATABASE_URL=mssql+pyodbc://@(localdb)\MSSQLLocalDB/PrestamosDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Integración con Base Legacy Oracle (Opcional - Modo Thick)
ORACLE_ENABLED=False
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=orcl
ORACLE_DSN=
ORACLE_CLIENT_LIB_DIR=
ORACLE_TABLA_PERSONAS=PRESTAPROD.PERSONA
